{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@pages/*": ["./pages/*"],
      "@store/*": ["./store/*"],
      "@api/*": ["./api/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "ts": {
    "checkJs": false
  }
}
